# Django
SECRET_KEY=change-me-generate-a-real-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Supabase Postgres (Settings > Database > Connection string, "URI" mode, port 5432 or 6543 pooler)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Email (for OTP fallback) — use an app password, not your real Gmail password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-team-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# reCAPTCHA v2 (https://www.google.com/recaptcha/admin)
RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=

# Biometric thresholds (tune after real-world testing)
FACE_MATCH_THRESHOLD=0.68
VOICE_MATCH_THRESHOLD=0.75
